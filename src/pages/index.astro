---
import { listCourses, listPlan } from "../lib/db";
import "../styles.css";

const courses = listCourses();
const plan = listPlan();
const plannedIds = new Set(plan.map((p) => p.courseId));
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Clash checker</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Clash checker</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Clash checker</h1>
      <p>
        Pick the courses you're considering and this checks your timetable for
        you — every session lives in SQLite, so your plan is still here after a
        reload, and two sessions that overlap are flagged the moment both are
        in your plan.
      </p>

      <h2>My plan</h2>
      {
        plan.length === 0 ? (
          <p>Nothing planned yet — add a course from the catalogue below.</p>
        ) : (
          <ul id="plan">
            {plan.map((p) => (
              <li class={p.clashesWith.length > 0 ? "clash" : ""}>
                <strong>{p.course.code}</strong> {p.course.title} — {p.course.day}{" "}
                {p.course.startTime}–{p.course.endTime} ({p.course.room})
                {p.clashesWith.length > 0 && (
                  <span class="clash-badge" role="alert">
                    clashes with {p.clashesWith.join(", ")}
                  </span>
                )}
                <form method="post" action="/api/selections/remove">
                  <input type="hidden" name="id" value={p.id} />
                  <button>Remove</button>
                </form>
              </li>
            ))}
          </ul>
        )
      }

      <h2>Catalogue</h2>
      <ul id="catalogue">
        {courses.map((course) => (
          <li>
            <strong>{course.code}</strong> {course.title} — {course.day}{" "}
            {course.startTime}–{course.endTime} ({course.room})
            {plannedIds.has(course.id) ? (
              <span>already in your plan</span>
            ) : (
              <form method="post" action="/api/selections">
                <input type="hidden" name="courseId" value={course.id} />
                <button>Add to plan</button>
              </form>
            )}
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
